{
  "expo": {
    "name": "TourVision",
    "slug": "tourvision",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tourvisionmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.mapstory.tourvision",
      "usesAppleSignIn": true,
      "appleTeamId": "589242RZ8A",
      "associatedDomains": [
        "applinks:tourvision.com",
        "applinks:www.tourvision.com"
      ]
    },
    "android": {
      "isTV": true,
      "uiMode": "television",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "io.mapstory.tourvision",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tourvision.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.tourvision.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "MAIN",
          "category": [
            "LEANBACK_LAUNCHER"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "./plugins/withDomWebViewExtension.js",
      "./plugins/withAndroidTVSupport.js",
      "@react-native-tvos/config-tv"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b92ba79b-40b9-4e3f-ba23-69f3b38bb880"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b92ba79b-40b9-4e3f-ba23-69f3b38bb880"
    }
  }
}
