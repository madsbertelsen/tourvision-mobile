{
  "name": "tourvision-mobile",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "y-partyserver",
    "agent-poc",
    "agent-system",
    "frontend-prosemirror",
    "server"
  ],
  "scripts": {
    "build:y-partyserver": "cd y-partyserver && npm run build",
    "build:agent-poc": "cd agent-poc && npm run build",
    "build:frontend": "cd frontend-prosemirror && npm run build",
    "build:server": "cd server && npm run build",
    "build": "npm run build:y-partyserver && npm run build:agent-poc",
    "dev:frontend": "cd frontend-prosemirror && npm run dev:client",
    "dev:server": "cd server && npm run dev:server"
  },
  "dependencies": {
    "@hocuspocus/provider": "^3.3.2",
    "@supabase/supabase-js": "^2.77.0",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.2",
    "prosemirror-slash-menu": "^0.4.5",
    "prosemirror-slash-menu-react": "^0.4.10",
    "ws": "^8.18.3",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
