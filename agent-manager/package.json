{
  "name": "agent-manager",
  "version": "1.0.0",
  "description": "Multi-document agent orchestration system",
  "type": "module",
  "scripts": {
    "agent-manager": "tsx manager.ts",
    "agent-worker": "tsx worker.ts",
    "build:manager": "tsc manager.ts --outDir dist --esModuleInterop --resolveJsonModule --moduleResolution node --module esnext --target es2020",
    "build:worker": "tsc worker.ts --outDir dist --esModuleInterop --resolveJsonModule --moduleResolution node --module esnext --target es2020"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.2",
    "ai": "^5.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "dotenv": "^16.4.7",
    "jsdom": "^25.0.1",
    "yjs": "^13.6.20",
    "y-websocket": "^2.0.4",
    "y-prosemirror": "^1.3.7",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.3",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-history": "^1.4.1",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.4.1",
    "ws": "^8.18.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
